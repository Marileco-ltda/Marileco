// schema.prisma — BASE OFICIAL DA MARILECO (FASE 1)
// Produtos + Pedidos (pronto para vender)

 generator client {
  provider = "prisma-client-js"
 }

 datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 }

 model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  price       Int      // em centavos (ex: R$ 49,90 = 4990)
  imageUrl    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
 }

 model Order {
  id        String      @id @default(uuid())
  email     String
  name      String
  address   String
  total     Int
  status    OrderStatus @default(PENDING)
  createdAt DateTime   @default(now())

  items     OrderItem[]
 }

 model OrderItem {
  id        String  @id @default(uuid())
  orderId  String
  productId String
  quantity Int
  price    Int

  order    Order   @relation(fields: [orderId], references: [id])
  product  Product @relation(fields: [productId], references: [id])
 }

 enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
 }
