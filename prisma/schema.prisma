generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
}
model Supplier {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())

  products  Product[]
}

