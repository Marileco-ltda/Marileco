generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int      // valor em centavos (ex: 1990 = R$19,90)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt  DateTime @default(now())
}
